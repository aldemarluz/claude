{
  "name": "Payment",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "subscription_id": {
      "type": "string",
      "title": "Subscription ID"
    },
    "pagarme_transaction_id": {
      "type": "string",
      "title": "Transaction ID Pagar.me"
    },
    "amount": {
      "type": "number",
      "title": "Valor (centavos)",
      "default": 0
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded",
        "waiting_payment"
      ],
      "default": "pending"
    },
    "payment_method": {
      "type": "string",
      "title": "M\u00e9todo de Pagamento",
      "enum": [
        "pix",
        "credit_card",
        "boleto"
      ],
      "default": "pix"
    },
    "pix_qr_code": {
      "type": "string",
      "title": "QR Code PIX"
    },
    "pix_expiration_date": {
      "type": "string",
      "format": "date-time",
      "title": "Expira\u00e7\u00e3o PIX"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "title": "Pago em"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    }
  },
  "required": [
    "user_id",
    "amount",
    "status",
    "payment_method"
  ]
}