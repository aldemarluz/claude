{
  "name": "QuickResponse",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "owner_email": {
      "type": "string",
      "title": "Email do Propriet\u00e1rio"
    },
    "titulo": {
      "type": "string",
      "title": "T\u00edtulo/Atalho"
    },
    "mensagem": {
      "type": "string",
      "title": "Mensagem"
    },
    "categoria": {
      "type": "string",
      "title": "Categoria",
      "enum": [
        "sauda\u00e7\u00e3o",
        "despedida",
        "suporte",
        "venda",
        "outro"
      ],
      "default": "outro"
    },
    "ordem": {
      "type": "number",
      "title": "Ordem",
      "default": 0
    }
  },
  "required": [
    "titulo",
    "mensagem"
  ]
}