{
  "name": "WhatsAppContact",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "title": "Account ID"
    },
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "channel_type": {
      "type": "string",
      "title": "Canal",
      "default": "whatsapp"
    },
    "nome": {
      "type": "string",
      "title": "Nome"
    },
    "telefone": {
      "type": "string",
      "title": "Telefone"
    },
    "group_jid": {
      "type": "string",
      "title": "JID do Grupo (se grupo)"
    },
    "is_group": {
      "type": "boolean",
      "title": "\u00c9 grupo",
      "default": false
    },
    "owner_email": {
      "type": "string",
      "title": "Conta Propriet\u00e1ria (email)"
    },
    "criado_em": {
      "type": "string",
      "format": "date-time",
      "title": "Criado em"
    },
    "profile_picture_url": {
      "type": "string",
      "title": "Foto de Perfil (URL)"
    },
    "profile_pic_updated_at": {
      "type": "string",
      "format": "date-time",
      "title": "Foto atualizada em"
    },
    "crm_contact_id": {
      "type": "string",
      "title": "Contact CRM ID (link)"
    }
  },
  "required": [
    "telefone"
  ]
}
