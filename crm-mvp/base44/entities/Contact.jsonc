{
  "name": "Contact",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "title": "Account ID"
    },
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "name": {
      "type": "string",
      "title": "Nome"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Telefone"
    },
    "company_id": {
      "type": "string",
      "title": "Empresa ID"
    },
    "company_name": {
      "type": "string",
      "title": "Empresa"
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "ativo",
        "inativo",
        "prospect"
      ],
      "default": "ativo"
    },
    "notes": {
      "type": "string",
      "title": "Notas"
    },
    "lead_id": {
      "type": "string",
      "title": "Lead Vinculado"
    },
    "origin": {
      "type": "string",
      "title": "Origem"
    },
    "last_contact": {
      "type": "string",
      "format": "date-time",
      "title": "\u00daltimo contato"
    },
    "whatsapp_id": {
      "type": "string",
      "title": "WhatsApp Contact ID (link)"
    },
    "instagram_id": {
      "type": "string",
      "title": "Instagram ID"
    },
    "messenger_id": {
      "type": "string",
      "title": "Messenger ID"
    },
    "tiktok_id": {
      "type": "string",
      "title": "TikTok ID"
    },
    "profile_picture_url": {
      "type": "string",
      "title": "Foto de perfil (cache)"
    }
  },
  "required": [
    "name"
  ]
}
