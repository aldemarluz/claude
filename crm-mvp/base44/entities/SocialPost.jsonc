{
  "name": "SocialPost",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "title": "Account ID"
    },
    "content": {
      "type": "string",
      "title": "Conte\u00fado"
    },
    "platform": {
      "type": "string",
      "title": "Plataforma",
      "enum": [
        "instagram",
        "facebook",
        "linkedin",
        "twitter"
      ],
      "default": "instagram"
    },
    "scheduled_at": {
      "type": "string",
      "title": "Data Agendada",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "agendado",
        "publicado",
        "rascunho"
      ],
      "default": "agendado"
    },
    "image_url": {
      "type": "string",
      "title": "Imagem URL"
    }
  },
  "required": [
    "content",
    "platform",
    "scheduled_at"
  ]
}