{
  "name": "WhatsAppMessage",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "title": "Account ID"
    },
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "channel_type": {
      "type": "string",
      "title": "Canal",
      "default": "whatsapp"
    },
    "channel_id": {
      "type": "string",
      "title": "Canal ID"
    },
    "message_id": {
      "type": "string",
      "title": "ID da Mensagem (provedor)"
    },
    "conversa_id": {
      "type": "string",
      "title": "Conversa ID"
    },
    "contato_id": {
      "type": "string",
      "title": "Contato ID"
    },
    "contact_id": {
      "type": "string",
      "title": "Contact ID (CRM)"
    },
    "direcao": {
      "type": "string",
      "title": "Dire\u00e7\u00e3o",
      "enum": [
        "inbound",
        "outbound"
      ],
      "default": "outbound"
    },
    "conteudo": {
      "type": "string",
      "title": "Conte\u00fado"
    },
    "media_url": {
      "type": "string",
      "title": "URL da M\u00eddia"
    },
    "media_type": {
      "type": "string",
      "title": "Tipo de M\u00eddia",
      "enum": [
        "image",
        "audio",
        "video",
        "document",
        "sticker",
        "text"
      ],
      "default": "text"
    },
    "media_mime": {
      "type": "string",
      "title": "MIME da m\u00eddia"
    },
    "media_size": {
      "type": "number",
      "title": "Tamanho da m\u00eddia (bytes)"
    },
    "file_name": {
      "type": "string",
      "title": "Nome do Arquivo"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "title": "Timestamp"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "enviado",
        "entregue",
        "lido",
        "falhou"
      ],
      "default": "pending"
    },
    "error": {
      "type": "string",
      "title": "Erro do provedor (se falhou)"
    },
    "owner_email": {
      "type": "string",
      "title": "Conta Propriet\u00e1ria (email)"
    },
    "is_automated": {
      "type": "boolean",
      "title": "Enviada por automa\u00e7\u00e3o",
      "default": false
    },
    "automation_rule_id": {
      "type": "string",
      "title": "Automa\u00e7\u00e3o que disparou"
    }
  },
  "required": [
    "conversa_id",
    "direcao"
  ]
}
