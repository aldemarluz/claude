{
  "name": "Task",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "title": "Account ID"
    },
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "contact_id": {
      "type": "string",
      "title": "Contato ID"
    },
    "title": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "type": {
      "type": "string",
      "title": "Tipo",
      "enum": [
        "task",
        "reminder",
        "call",
        "meeting",
        "follow_up"
      ],
      "default": "task"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "done",
        "cancelled"
      ],
      "default": "pending"
    },
    "due_date": {
      "type": "string",
      "format": "date-time",
      "title": "Data/Hora"
    },
    "priority": {
      "type": "string",
      "title": "Prioridade",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    }
  },
  "required": [
    "title"
  ]
}