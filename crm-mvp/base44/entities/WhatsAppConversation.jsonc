{
  "name": "WhatsAppConversation",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "contato_id": {
      "type": "string",
      "title": "Contato ID"
    },
    "contato_nome": {
      "type": "string",
      "title": "Nome do Contato"
    },
    "contato_telefone": {
      "type": "string",
      "title": "Telefone do Contato"
    },
    "canal_id": {
      "type": "string",
      "title": "Canal ID"
    },
    "ultima_mensagem": {
      "type": "string",
      "title": "\u00daltima Mensagem"
    },
    "nao_lido": {
      "type": "boolean",
      "title": "N\u00e3o Lido",
      "default": false
    },
    "unread_count": {
      "type": "number",
      "title": "Qtd. n\u00e3o lidas",
      "default": 0
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "aberta",
        "fechada"
      ],
      "default": "aberta"
    },
    "assigned_to": {
      "type": "string",
      "title": "Respons\u00e1vel (email)"
    },
    "owner_email": {
      "type": "string",
      "title": "Conta Propriet\u00e1ria (email)"
    },
    "criado_em": {
      "type": "string",
      "format": "date-time",
      "title": "Criado em"
    },
    "atualizado_em": {
      "type": "string",
      "format": "date-time",
      "title": "Atualizado em"
    },
    "profile_picture_url": {
      "type": "string",
      "title": "Foto do contato (cache)"
    },
    "is_group": {
      "type": "boolean",
      "title": "\u00c9 grupo",
      "default": false
    }
  },
  "required": [
    "contato_id",
    "status"
  ]
}