{
  "name": "WhatsAppConversation",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "title": "Account ID"
    },
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "channel_type": {
      "type": "string",
      "title": "Canal",
      "default": "whatsapp"
    },
    "contato_id": {
      "type": "string",
      "title": "Contato ID (WhatsAppContact)"
    },
    "contact_id": {
      "type": "string",
      "title": "Contact ID (CRM)"
    },
    "lead_id": {
      "type": "string",
      "title": "Lead ID"
    },
    "contato_nome": {
      "type": "string",
      "title": "Nome do Contato"
    },
    "contato_telefone": {
      "type": "string",
      "title": "Telefone do Contato"
    },
    "canal_id": {
      "type": "string",
      "title": "Canal ID"
    },
    "ultima_mensagem": {
      "type": "string",
      "title": "\u00daltima Mensagem"
    },
    "nao_lido": {
      "type": "boolean",
      "title": "N\u00e3o Lido",
      "default": false
    },
    "unread_count": {
      "type": "number",
      "title": "Qtd. n\u00e3o lidas",
      "default": 0
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "title": "Hor\u00e1rio da \u00faltima mensagem"
    },
    "last_direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "title": "Dire\u00e7\u00e3o da \u00faltima mensagem"
    },
    "last_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "delivered",
        "read",
        "failed"
      ],
      "title": "Status da \u00faltima mensagem"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "aberta",
        "fechada",
        "arquivada"
      ],
      "default": "aberta"
    },
    "assigned_to": {
      "type": "string",
      "title": "Respons\u00e1vel (email)"
    },
    "owner_email": {
      "type": "string",
      "title": "Conta Propriet\u00e1ria (email)"
    },
    "criado_em": {
      "type": "string",
      "format": "date-time",
      "title": "Criado em"
    },
    "atualizado_em": {
      "type": "string",
      "format": "date-time",
      "title": "Atualizado em"
    },
    "profile_picture_url": {
      "type": "string",
      "title": "Foto do contato (cache)"
    },
    "is_group": {
      "type": "boolean",
      "title": "\u00c9 grupo",
      "default": false
    }
  },
  "required": [
    "contato_id",
    "status"
  ]
}
