{
  "name": "AutomationRule",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "title": "Workspace ID"
    },
    "owner_email": {
      "type": "string",
      "title": "Owner Email"
    },
    "name": {
      "type": "string",
      "title": "Nome"
    },
    "trigger": {
      "type": "string",
      "title": "Gatilho",
      "enum": [
        "first_message",
        "message_received",
        "message_contains",
        "no_response",
        "lead_created",
        "status_changed",
        "tag_added",
        "whatsapp_received",
        "form_submitted"
      ]
    },
    "trigger_value": {
      "type": "string",
      "title": "Valor do Gatilho"
    },
    "action": {
      "type": "string",
      "title": "A\u00e7\u00e3o",
      "enum": [
        "send_whatsapp",
        "send_email",
        "add_tag",
        "change_status",
        "assign_lead",
        "wait",
        "create_lead",
        "notify_team"
      ]
    },
    "action_value": {
      "type": "string",
      "title": "Valor da A\u00e7\u00e3o"
    },
    "is_active": {
      "type": "boolean",
      "title": "Ativo",
      "default": true
    },
    "flow_nodes": {
      "type": "string",
      "title": "N\u00f3s do Fluxo (JSON)"
    },
    "executions": {
      "type": "number",
      "title": "Execu\u00e7\u00f5es",
      "default": 0
    },
    "last_executed_at": {
      "type": "string",
      "format": "date-time",
      "title": "\u00daltima execu\u00e7\u00e3o"
    }
  },
  "required": [
    "name"
  ]
}